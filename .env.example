# Backend API port
PORT=8787

# Host directory for persistent app data.
# Keep this backed up; it contains imported calendar and settings.
DATA_DIR=./.data

# Docker image used by docker compose.
# Local development default builds iracing-race-radar:local.
# On Unraid, prefer ghcr.io/petrflorian/iracing-race-radar:latest.
# IMAGE=ghcr.io/petrflorian/iracing-race-radar:latest

# Local timezone used by the container.
TZ=Europe/Prague

# Set to "production" for static file serving from dist/
# NODE_ENV=production
